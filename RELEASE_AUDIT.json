{
  "release": "SafeGrip-Open v0.9.0 / SafeGrip-CI",
  "purpose": "trust-region correction of the v0.8 SafeGrip-CI innovation/authority mechanism and statistical evaluation pipeline",
  "final_static_test_count": 55,
  "release_validation": {
    "pytest": "55 passed, 2 warnings",
    "cli_help": true,
    "workflow_shell_syntax": true,
    "synthetic_end_to_end_benchmark": "started but not claimed in this packaging build because the command exceeded the session limit",
    "primary_ablation_count": 11
  },
  "verified_invariants": [
    "LiRA decoding and leakage-safe trajectory segmentation retained",
    "full SafeGrip-CI point estimator uses raw sensor features",
    "persistent friction state resets at trajectory-segment boundaries",
    "candidate innovation supervision is separated from update authority",
    "counterfactual identifiability is computed from friction-conditioned dynamics sensitivity",
    "candidate-vs-prior dynamics evidence is normalized before authority decisions",
    "neutral evidence does not automatically halve the innovation",
    "harmful candidate updates can be asymmetrically vetoed",
    "local inverse-dynamics agreement is isolated by a primary ablation",
    "final point output remains parameterized inside the conditional identified set",
    "per-seed predictions are exported separately from ensemble predictions",
    "statistical comparison uses registered model predictions with seed/trajectory-aware resampling",
    "lower-bound and predictive-UQ calibration roles remain disjoint",
    "primary ablations use explicit semantic specifications and are unit-tested for distinctness"
  ],
