{
  "release": "SafeGrip-Open v0.7.0",
  "purpose": "SafeGrip-v3 proposal redesign after the v0.6 trust run exposed flat prediction and non-interpretable excitation gating",
  "final_static_test_count": 43,
  "verified_invariants": [
    "LiRA Table-2 encoded CAN decoding retained",
    "mandatory speed/ax/ay fail-fast retained",
    "trajectory-aware spatial splits and segment-safe windows retained",
    "training-only scaler fitting retained; proposal excitation score is deliberately restored to physical [0,1] scale",
    "literature baselines do not receive SafeGrip-only engineered features",
    "benchmark warm-up does not depend on unused tuning candidates",
    "SafeGrip excitation features are label-free, causal, and split/segment safe",
    "SafeGrip-v3 separates a long-context prior from short-context dynamic evidence",
    "excitation reliability is monotone non-decreasing by construction",
    "SafeGrip point output is parameterized inside the identified set",
    "point estimator uses Huber plus same-segment relative/ranking/smoothness regularization without joint uncertainty training",
    "vehicle-level mechanics lower bound uses conditional vector force balance with explicit uncertainty margins",
    "residual-scale UQ is trained only after point-model selection and initialized near validation residual scale",
    "lower-bound and predictive-UQ calibration labels are disjoint",
    "block-max conformal scores mitigate overlapping-window dependence without claiming arbitrary-dependence validity",
    "health gate checks train-mean performance, positive R2, sample count, lower-bound coverage, predictive interval coverage, and excitation/reliability direction",
    "processed-data SHA-256 reproducibility manifest retained"
  ],
  "official_lira_reference": {
    "title": "LiRA-CD: An open-source dataset for road condition modelling and research",
    "doi": "10.11583/DTU.c.6659909"
  },
