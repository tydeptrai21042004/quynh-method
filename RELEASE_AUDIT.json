{
  "release": "SafeGrip-Open v0.8.0 / SafeGrip-CI",
  "purpose": "counterfactual-identifiability proposal redesign after v0.7 trust diagnostics showed handcrafted excitation could harm prediction",
  "final_static_test_count": 51,
  "release_validation": {
    "pytest": "51 passed, 2 warnings",
    "cli_help": true,
    "synthetic_end_to_end_benchmark": true,
    "synthetic_primary_ablation_count": 10
  },
  "verified_invariants": [
    "LiRA decoding and leakage-safe trajectory segmentation retained",
    "full SafeGrip-CI point estimator uses raw sensor features",
    "persistent friction state resets at trajectory-segment boundaries",
    "candidate innovation is supervised separately from accepted update authority",
    "counterfactual identifiability is computed from friction-conditioned dynamics sensitivity",
    "candidate acceptance depends on improvement of observed dynamics consistency",
    "final point output remains parameterized inside the conditional identified set",
    "dynamics model is warm-started before joint authority-controlled training",
    "post-hoc UQ inflation depends on low identifiability rather than handcrafted excitation",
    "lower-bound and predictive-UQ calibration roles remain disjoint",
    "primary ablations use explicit semantic specifications and are unit-tested for distinctness",
    "legacy v0.7 ablation names are compatibility aliases only and are not primary v0.8 paper variants"
  ],
